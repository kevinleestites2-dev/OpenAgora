# OpenAgora — Environment Variables
# Copy to .env and fill in your values
# All of these are also wired as GitHub Actions secrets

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

POLYMARKET_API_KEY=your_polymarket_api_key
POLYMARKET_API_SECRET=your_polymarket_api_secret
POLYMARKET_API_PASSPHRASE=your_polymarket_passphrase
POLYMARKET_WALLET=your_wallet_address

FINNHUB_API_KEY=your_finnhub_key

# Trading config
SIMULATE_MODE=true
MIN_CONFIDENCE=0.3
CYCLE_INTERVAL=300
INITIAL_WAR_CHEST=1000
MAX_POSITION_RISK_PERCENT=2
STOP_LOSS_PERCENT=5
DAILY_DRAWDOWN_LIMIT_PERCENT=10
