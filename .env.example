# OpenAgora — Environment Config

# === FABLE 5 (Primary Brain — Pantheon Standard) ===
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
OPENROUTER_MODEL=anthropic/claude-fable-5

# === TELEGRAM (Pantheon Reporting) ===
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=7135054241

# === POLYMARKET (Prediction Markets) ===
POLY_API_KEY=YOUR_POLY_API_KEY
POLY_API_SECRET=YOUR_POLY_SECRET
POLY_API_PASSPHRASE=YOUR_POLY_PASSPHRASE
POLY_WALLET=YOUR_WALLET
POLY_PRIVATE_KEY=YOUR_PRIVATE_KEY

# === KALSHI (Prediction Markets) ===
KALSHI_API_KEY_ID=YOUR_KALSHI_KEY_ID
KALSHI_PRIVATE_KEY_PATH=kalshi.key
KALSHI_ENABLED=true

# === CRYPTO (CoinGecko — free, no key needed) ===
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# === STOCKS (Marketstack — free tier) ===
MARKETSTACK_API_KEY=your_marketstack_key_here

# === GOOGLE AI (Gemini — Fallback brain) ===
GEMINI_API_KEY=YOUR_GEMINI_KEY

# === MIDAS PRIME (War Chest) ===
WAR_CHEST_PATH=logs/war_chest.json

# === MODE ===
SIMULATE_MODE=true
MIN_CONFIDENCE=0.65
